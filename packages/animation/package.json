{
  "name": "@quickadui/animation",
  "version": "0.1.0",
  "description": "Motion (formerly Framer Motion) presets, reusable animation variants, and a Reveal convenience component.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdouaniHoussemKhalil/quickadui-.git",
    "directory": "packages/animation"
  },
  "homepage": "https://github.com/AdouaniHoussemKhalil/quickadui-/tree/main/packages/animation#readme",
  "bugs": {
    "url": "https://github.com/AdouaniHoussemKhalil/quickadui-/issues"
  },
  "author": "Houssem Adouani Khalil (https://github.com/AdouaniHoussemKhalil)",
  "keywords": [
    "react",
    "animation",
    "motion",
    "quickadui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@quickadui/config": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "motion": "^13.4.0"
  }
}
