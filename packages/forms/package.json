{
  "name": "@quickadui/forms",
  "version": "0.2.1",
  "description": "Form field components (Input, Textarea, Select, Checkbox, Switch, RadioGroup, Label) plus a React Hook Form + Zod bindings layer (Form, FormField, FormItem, FormLabel, FormControl, FormDescription, FormMessage).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdouaniHoussemKhalil/quickadui-.git",
    "directory": "packages/forms"
  },
  "homepage": "https://github.com/AdouaniHoussemKhalil/quickadui-/tree/main/packages/forms#readme",
  "bugs": {
    "url": "https://github.com/AdouaniHoussemKhalil/quickadui-/issues"
  },
  "author": "Houssem Adouani Khalil (https://github.com/AdouaniHoussemKhalil)",
  "keywords": [
    "react",
    "forms",
    "react-hook-form",
    "zod",
    "quickadui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@quickadui/config": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "react-hook-form": "^7.88.0",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.0",
    "@quickadui/icons": "workspace:*",
    "@quickadui/primitives": "workspace:*",
    "@quickadui/theme": "workspace:*",
    "@quickadui/utils": "workspace:*"
  }
}
