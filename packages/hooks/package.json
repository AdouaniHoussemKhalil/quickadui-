{
  "name": "@quickadui/hooks",
  "version": "0.0.0",
  "description": "Framework-agnostic utility hooks (useDisclosure, useMediaQuery, useDebounce, and friends).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdouaniHoussemKhalil/quickadui-.git",
    "directory": "packages/hooks"
  },
  "homepage": "https://github.com/AdouaniHoussemKhalil/quickadui-/tree/main/packages/hooks#readme",
  "bugs": {
    "url": "https://github.com/AdouaniHoussemKhalil/quickadui-/issues"
  },
  "author": "Houssem Adouani Khalil (https://github.com/AdouaniHoussemKhalil)",
  "keywords": [
    "react",
    "hooks",
    "quickadui"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@quickadui/config": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
