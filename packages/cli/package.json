{
  "name": "create-quickadui",
  "version": "0.1.1",
  "description": "create-quickadui — scaffolds a Vite + React + Tailwind v4 project (`quickadui init`) and installs QuickadUI packages into it (`quickadui add`). Editing an existing project's CSS is left to the person (see README) — narrower than the original framework-detection scope in Blueprint §4/§9.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdouaniHoussemKhalil/quickadui-.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/AdouaniHoussemKhalil/quickadui-/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/AdouaniHoussemKhalil/quickadui-/issues"
  },
  "author": "Houssem Adouani Khalil (https://github.com/AdouaniHoussemKhalil)",
  "keywords": [
    "cli",
    "scaffold",
    "vite",
    "react",
    "quickadui"
  ],
  "type": "module",
  "bin": {
    "quickadui": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@quickadui/config": "workspace:*",
    "@types/node": "^22.20.3",
    "tsup": "^8.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
